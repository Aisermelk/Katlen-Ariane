<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="robots"
        content="noindex, nofollow"
    >

    <title>ADM | Katlen Ariane</title>

    <link
        rel="stylesheet"
        href="admin.css"
    >

</head>


<body>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header class="admin-header">

    <div class="admin-header-inner">


        <div class="admin-brand">

            <div class="admin-logo">
                KA
            </div>


            <div>

                <strong>
                    Katlen Ariane
                </strong>

                <span>
                    Painel administrativo
                </span>

            </div>

        </div>


        <a
            href="../index.html"
            target="_blank"
            rel="noopener"
            class="view-site"
        >
            Ver site
        </a>

    </div>

</header>



<!-- =========================================================
     CONTEÚDO PRINCIPAL
     ========================================================= -->

<main class="admin-main">

    <div class="admin-container">


        <!-- =================================================
             MENSAGEM
             ================================================= -->

        <div
            id="message"
            class="save-message"
            aria-live="polite"
        ></div>



        <!-- =================================================
             LOGIN
             ================================================= -->

        <section
            id="login-view"
            class="admin-card"
        >

            <div class="page-heading">

                <span class="eyebrow">
                    Acesso restrito
                </span>


                <h1>
                    Entrar no painel
                </h1>


                <p>
                    Acesse as configurações do site
                    da Katlen Ariane.
                </p>

            </div>


            <form id="login-form">


                <div class="field">

                    <label for="login-user">
                        Usuário
                    </label>


                    <input
                        type="text"
                        id="login-user"
                        autocomplete="username"
                        required
                    >

                </div>


                <br>


                <div class="field">

                    <label for="login-pass">
                        Senha
                    </label>


                    <input
                        type="password"
                        id="login-pass"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <div class="admin-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="login-button"
                    >
                        Entrar
                    </button>

                </div>

            </form>

        </section>



        <!-- =================================================
             PAINEL ADMINISTRATIVO
             ================================================= -->

        <section
            id="panel-view"
            hidden
        >


            <!-- CABEÇALHO -->

            <div class="page-heading">

                <span class="eyebrow">
                    Administração
                </span>


                <h1>
                    Configurações do site
                </h1>


                <p>
                    Atualize as informações utilizadas
                    pelo site da Katlen Ariane.
                </p>

            </div>



            <form id="config-form">


                <!-- =================================================
                     01 — DADOS PROFISSIONAIS
                     ================================================= -->

                <section class="admin-card">


                    <div class="card-heading">

                        <span class="card-number">
                            01
                        </span>


                        <div>

                            <h2>
                                Dados profissionais
                            </h2>


                            <p>
                                Informações profissionais
                                exibidas no site.
                            </p>

                        </div>

                    </div>



                    <div class="form-grid">


                        <!-- REGISTRO -->

                        <div class="field">

                            <label for="professionalRegistration">
                                Registro profissional
                            </label>


                            <input
                                type="text"
                                id="professionalRegistration"
                                placeholder="CBPC 2022-6172"
                            >

                        </div>



                        <!-- NOME DO REGISTRO -->

                        <div class="field">

                            <label for="professionalRegistrationLabel">
                                Nome do registro
                            </label>


                            <input
                                type="text"
                                id="professionalRegistrationLabel"
                                value="Registro profissional"
                            >

                        </div>



                        <!-- FORMAÇÃO -->

                        <div class="field field-full">

                            <label for="formacao">
                                Formação
                            </label>


                            <textarea
                                id="formacao"
                                rows="4"
                                placeholder="Informe a formação profissional..."
                            ></textarea>

                        </div>



                        <!-- ESPECIALIZAÇÕES -->

                        <div class="field field-full">

                            <label for="especializacoes">
                                Especializações
                            </label>


                            <textarea
                                id="especializacoes"
                                rows="4"
                                placeholder="Informe as especializações..."
                            ></textarea>

                        </div>



                        <!-- EXPERIÊNCIA -->

                        <div class="field field-full">

                            <label for="experiencia">
                                Experiência
                            </label>


                            <textarea
                                id="experiencia"
                                rows="4"
                                placeholder="Informe a experiência profissional..."
                            ></textarea>

                        </div>

                    </div>

                </section>



                <!-- =================================================
                     02 — CONTATO
                     ================================================= -->

                <section class="admin-card">


                    <div class="card-heading">

                        <span class="card-number">
                            02
                        </span>


                        <div>

                            <h2>
                                Contato
                            </h2>


                            <p>
                                Informações para contato
                                e atendimento.
                            </p>

                        </div>

                    </div>



                    <div class="form-grid">


                        <!-- WHATSAPP -->

                        <div class="field">

                            <label for="whatsapp">
                                WhatsApp
                            </label>


                            <input
                                type="tel"
                                id="whatsapp"
                                placeholder="5511999999999"
                                inputmode="numeric"
                            >


                            <small>
                                Somente números,
                                incluindo DDI e DDD.
                            </small>

                        </div>



                        <!-- ENDEREÇO -->

                        <div class="field">

                            <label for="endereco">
                                Endereço
                            </label>


                            <input
                                type="text"
                                id="endereco"
                                placeholder="Rua, número, bairro, cidade - UF"
                            >

                        </div>

                    </div>

                </section>



                <!-- =================================================
                     03 — FORMSPREE
                     ================================================= -->

                <section class="admin-card">


                    <div class="card-heading">

                        <span class="card-number">
                            03
                        </span>


                        <div>

                            <h2>
                                Formulário
                            </h2>


                            <p>
                                Configuração do recebimento
                                dos contatos.
                            </p>

                        </div>

                    </div>



                    <div class="field">

                        <label for="formspreeEndpoint">
                            Endpoint do Formspree
                        </label>


                        <input
                            type="url"
                            id="formspreeEndpoint"
                            placeholder="https://formspree.io/f/xxxxxxxx"
                        >


                        <small>
                            Cole aqui o endpoint completo
                            do formulário.
                        </small>

                    </div>

                </section>



                <!-- =================================================
                     04 — REDES SOCIAIS
                     ================================================= -->

                <section class="admin-card">


                    <div class="card-heading">

                        <span class="card-number">
                            04
                        </span>


                        <div>

                            <h2>
                                Redes sociais
                            </h2>


                            <p>
                                Links das redes profissionais.
                            </p>

                        </div>

                    </div>



                    <div class="form-grid">


                        <!-- INSTAGRAM -->

                        <div class="field">

                            <label for="instagram">
                                Instagram
                            </label>


                            <input
                                type="url"
                                id="instagram"
                                placeholder="https://instagram.com/..."
                            >

                        </div>



                        <!-- FACEBOOK -->

                        <div class="field">

                            <label for="facebook">
                                Facebook
                            </label>


                            <input
                                type="url"
                                id="facebook"
                                placeholder="https://facebook.com/..."
                            >

                        </div>



                        <!-- TIKTOK -->

                        <div class="field">

                            <label for="tiktok">
                                TikTok
                            </label>


                            <input
                                type="url"
                                id="tiktok"
                                placeholder="https://tiktok.com/@..."
                            >

                        </div>



                        <!-- LINKEDIN -->

                        <div class="field">

                            <label for="linkedin">
                                LinkedIn
                            </label>


                            <input
                                type="url"
                                id="linkedin"
                                placeholder="https://linkedin.com/in/..."
                            >

                        </div>

                    </div>

                </section>



                <!-- =================================================
                     05 — RASTREAMENTO
                     ================================================= -->

                <section class="admin-card">


                    <div class="card-heading">

                        <span class="card-number">
                            05
                        </span>


                        <div>

                            <h2>
                                Rastreamento
                            </h2>


                            <p>
                                Integrações de marketing
                                e análise.
                            </p>

                        </div>

                    </div>



                    <div class="form-grid">


                        <!-- META PIXEL -->

                        <div class="field">

                            <label for="metaPixelId">
                                Meta Pixel ID
                            </label>


                            <input
                                type="text"
                                id="metaPixelId"
                                placeholder="123456789012345"
                            >

                        </div>



                        <div class="field">

                            <label>
                                Status do Meta Pixel
                            </label>


                            <label class="tracking-toggle">

                                <input
                                    type="checkbox"
                                    id="pixelEnabled"
                                >


                                <span>
                                    Ativar Pixel
                                </span>

                            </label>

                        </div>



                        <!-- GOOGLE ANALYTICS -->

                        <div class="field">

                            <label for="gaMeasurementId">
                                Google Analytics
                            </label>


                            <input
                                type="text"
                                id="gaMeasurementId"
                                placeholder="G-XXXXXXXXXX"
                            >

                        </div>



                        <div class="field">

                            <label>
                                Status do Google Analytics
                            </label>


                            <label class="tracking-toggle">

                                <input
                                    type="checkbox"
                                    id="gaEnabled"
                                >


                                <span>
                                    Ativar GA
                                </span>

                            </label>

                        </div>



                        <!-- GOOGLE TAG MANAGER -->

                        <div class="field">

                            <label for="gtmId">
                                Google Tag Manager
                            </label>


                            <input
                                type="text"
                                id="gtmId"
                                placeholder="GTM-XXXXXXX"
                            >

                        </div>



                        <div class="field">

                            <label>
                                Status do Google Tag Manager
                            </label>


                            <label class="tracking-toggle">

                                <input
                                    type="checkbox"
                                    id="gtmEnabled"
                                >


                                <span>
                                    Ativar GTM
                                </span>

                            </label>

                        </div>

                    </div>

                </section>



                <!-- =================================================
                     AÇÕES
                     ================================================= -->

                <div class="admin-actions">


                    <button
                        type="button"
                        class="btn btn-secondary"
                        id="logout-button"
                    >
                        Sair
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="save-button"
                    >
                        Salvar configurações
                    </button>

                </div>


                <div
                    id="save-status"
                    class="save-message"
                    aria-live="polite"
                ></div>


            </form>

        </section>

    </div>

</main>



<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer class="admin-footer">

    <div class="admin-container">

        <span>
            ADM Katlen Ariane
        </span>


        <span>
            V8 Digital
        </span>

    </div>

</footer>



<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script src="admin.js"></script>


</body>

</html>
