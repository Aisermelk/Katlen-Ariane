<!DOCTYPE html>

<html lang="pt-BR">

<head>

```
<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>ADM | Katlen Ariane</title>

<meta
    name="description"
    content="Painel administrativo do site Katlen Ariane."
>

<link
    rel="stylesheet"
    href="admin.css"
>
```

</head>

<body>

```
<header class="admin-header">

    <div class="admin-header-inner">

        <div class="admin-brand">

            <div class="admin-logo">
                KA
            </div>

            <div>
                <strong>Katlen Ariane</strong>
                <span>Painel administrativo</span>
            </div>

        </div>

        <a
            href="../index.html"
            class="view-site"
            target="_blank"
        >
            Ver site
        </a>

    </div>

</header>


<main class="admin-main">

    <div class="admin-container">

        <div class="page-heading">

            <span class="eyebrow">
                Administração
            </span>

            <h1>
                Configurações do site
            </h1>

            <p>
                Atualize as informações que serão
                utilizadas no site da Katlen Ariane.
            </p>

        </div>


        <form id="admin-form">


            <!-- =================================================
                 DADOS PROFISSIONAIS
                 ================================================= -->

            <section class="admin-card">

                <div class="card-heading">

                    <span class="card-number">
                        01
                    </span>

                    <div>

                        <h2>
                            Dados profissionais
                        </h2>

                        <p>
                            Informações principais da profissional.
                        </p>

                    </div>

                </div>


                <div class="form-grid">

                    <div class="field field-full">

                        <label for="nome">
                            Nome
                        </label>

                        <input
                            type="text"
                            id="nome"
                            name="nome"
                            placeholder="Katlen Ariane"
                        >

                    </div>


                    <div class="field">

                        <label for="registro">
                            Registro profissional
                        </label>

                        <input
                            type="text"
                            id="registro"
                            name="registro"
                            placeholder="CBPC 2022-6172"
                        >

                    </div>


                    <div class="field">

                        <label for="profissao">
                            Profissão
                        </label>

                        <input
                            type="text"
                            id="profissao"
                            name="profissao"
                            placeholder="Psicanalista Clínica"
                        >

                    </div>


                    <div class="field field-full">

                        <label for="formacao">
                            Formação
                        </label>

                        <textarea
                            id="formacao"
                            name="formacao"
                            rows="4"
                            placeholder="Digite a formação profissional..."
                        ></textarea>

                    </div>


                    <div class="field field-full">

                        <label for="especializacoes">
                            Especializações
                        </label>

                        <textarea
                            id="especializacoes"
                            name="especializacoes"
                            rows="4"
                            placeholder="Digite as especializações..."
                        ></textarea>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 CONTATO
                 ================================================= -->

            <section class="admin-card">

                <div class="card-heading">

                    <span class="card-number">
                        02
                    </span>

                    <div>

                        <h2>
                            Contato
                        </h2>

                        <p>
                            Informações utilizadas para contato.
                        </p>

                    </div>

                </div>


                <div class="form-grid">

                    <div class="field">

                        <label for="whatsapp">
                            WhatsApp
                        </label>

                        <input
                            type="tel"
                            id="whatsapp"
                            name="whatsapp"
                            placeholder="(00) 00000-0000"
                        >

                    </div>


                    <div class="field">

                        <label for="email">
                            E-mail
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="contato@email.com"
                        >

                    </div>


                    <div class="field field-full">

                        <label for="endereco">
                            Endereço
                        </label>

                        <input
                            type="text"
                            id="endereco"
                            name="endereco"
                            placeholder="Endereço do atendimento"
                        >

                    </div>


                    <div class="field">

                        <label for="atendimento">
                            Modalidade
                        </label>

                        <select
                            id="atendimento"
                            name="atendimento"
                        >

                            <option value="">
                                Selecione
                            </option>

                            <option value="online">
                                Online
                            </option>

                            <option value="presencial">
                                Presencial
                            </option>

                            <option value="online-presencial">
                                Online e presencial
                            </option>

                        </select>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 FORMSPREE
                 ================================================= -->

            <section class="admin-card">

                <div class="card-heading">

                    <span class="card-number">
                        03
                    </span>

                    <div>

                        <h2>
                            Formulário
                        </h2>

                        <p>
                            Configure o recebimento dos contatos.
                        </p>

                    </div>

                </div>


                <div class="field">

                    <label for="formspree">
                        Endpoint do Formspree
                    </label>

                    <input
                        type="url"
                        id="formspree"
                        name="formspreeEndpoint"
                        placeholder="https://formspree.io/f/xxxxxxxx"
                    >

                    <small>
                        Exemplo: https://formspree.io/f/xxxxxxxx
                    </small>

                </div>

            </section>


            <!-- =================================================
                 REDES SOCIAIS
                 ================================================= -->

            <section class="admin-card">

                <div class="card-heading">

                    <span class="card-number">
                        04
                    </span>

                    <div>

                        <h2>
                            Redes sociais
                        </h2>

                        <p>
                            Links das redes sociais profissionais.
                        </p>

                    </div>

                </div>


                <div class="form-grid">

                    <div class="field">

                        <label for="instagram">
                            Instagram
                        </label>

                        <input
                            type="url"
                            id="instagram"
                            name="instagram"
                            placeholder="https://instagram.com/..."
                        >

                    </div>


                    <div class="field">

                        <label for="facebook">
                            Facebook
                        </label>

                        <input
                            type="url"
                            id="facebook"
                            name="facebook"
                            placeholder="https://facebook.com/..."
                        >

                    </div>


                    <div class="field">

                        <label for="tiktok">
                            TikTok
                        </label>

                        <input
                            type="url"
                            id="tiktok"
                            name="tiktok"
                            placeholder="https://tiktok.com/@..."
                        >

                    </div>


                    <div class="field">

                        <label for="linkedin">
                            LinkedIn
                        </label>

                        <input
                            type="url"
                            id="linkedin"
                            name="linkedin"
                            placeholder="https://linkedin.com/in/..."
                        >

                    </div>

                </div>

            </section>


            <!-- =================================================
                 TEXTOS DO SITE
                 ================================================= -->

            <section class="admin-card">

                <div class="card-heading">

                    <span class="card-number">
                        05
                    </span>

                    <div>

                        <h2>
                            Conteúdo
                        </h2>

                        <p>
                            Textos principais exibidos no site.
                        </p>

                    </div>

                </div>


                <div class="form-grid">

                    <div class="field field-full">

                        <label for="about">
                            Texto sobre
                        </label>

                        <textarea
                            id="about"
                            name="about"
                            rows="6"
                            placeholder="Texto apresentado na seção Sobre..."
                        ></textarea>

                    </div>


                    <div class="field field-full">

                        <label for="neuro">
                            Texto sobre neurodesenvolvimento
                        </label>

                        <textarea
                            id="neuro"
                            name="neuro"
                            rows="6"
                            placeholder="Texto da seção Neurodesenvolvimento..."
                        ></textarea>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 AÇÕES
                 ================================================= -->

            <div class="admin-actions">

                <button
                    type="button"
                    class="btn btn-secondary"
                    id="reset-button"
                >
                    Limpar
                </button>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Salvar configurações
                </button>

            </div>


            <div
                class="save-message"
                id="save-message"
                role="status"
                aria-live="polite"
            ></div>


        </form>

    </div>

</main>


<footer class="admin-footer">

    <div class="admin-container">

        <span>
            ADM Katlen Ariane
        </span>

        <span>
            V8 Digital
        </span>

    </div>

</footer>


<script src="admin.js"></script>
```

</body>

</html>
