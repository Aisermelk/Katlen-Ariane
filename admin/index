<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="robots"
        content="noindex, nofollow"
    >

    <title>ADM | Katlen Ariane</title>

    <link
        rel="stylesheet"
        href="admin.css"
    >
</head>

<body>

<header class="admin-header">

    <div class="header-inner">

        <div class="brand">

            <div class="brand-mark">
                KA
            </div>

            <div>
                <strong>Katlen Ariane</strong>
                <span>Painel administrativo</span>
            </div>

        </div>

        <a
            href="../index.html"
            target="_blank"
            class="view-site"
        >
            Ver site
        </a>

    </div>

</header>


<main class="admin-main">

    <div class="container">

        <div
            id="message"
            class="message"
            aria-live="polite"
        ></div>


        <!-- LOGIN -->

        <section
            id="login-view"
            class="login-card"
        >

            <div class="login-heading">

                <span class="eyebrow">
                    Acesso restrito
                </span>

                <h1>
                    Entrar no painel
                </h1>

                <p>
                    Acesse as configurações do site.
                </p>

            </div>


            <form id="login-form">

                <div class="field">

                    <label for="login-user">
                        Usuário
                    </label>

                    <input
                        type="text"
                        id="login-user"
                        autocomplete="username"
                        required
                    >

                </div>


                <div class="field">

                    <label for="login-pass">
                        Senha
                    </label>

                    <input
                        type="password"
                        id="login-pass"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Entrar
                </button>

            </form>

        </section>


        <!-- PAINEL -->

        <section
            id="panel-view"
            class="panel"
            hidden
        >

            <div class="page-heading">

                <div>

                    <span class="eyebrow">
                        Administração
                    </span>

                    <h1>
                        Configurações do site
                    </h1>

                    <p>
                        Atualize as informações utilizadas
                        pelo site da Katlen Ariane.
                    </p>

                </div>

                <button
                    type="button"
                    id="logout-button"
                    class="btn btn-secondary"
                >
                    Sair
                </button>

            </div>


            <form id="config-form">


                <!-- DADOS PROFISSIONAIS -->

                <section class="card">

                    <div class="card-title">

                        <span>01</span>

                        <div>
                            <h2>Dados profissionais</h2>
                            <p>
                                Informações profissionais exibidas no site.
                            </p>
                        </div>

                    </div>


                    <div class="grid">

                        <div class="field">

                            <label for="professionalRegistration">
                                Registro profissional
                            </label>

                            <input
                                type="text"
                                id="professionalRegistration"
                            >

                        </div>


                        <div class="field">

                            <label for="professionalRegistrationLabel">
                                Nome do registro
                            </label>

                            <input
                                type="text"
                                id="professionalRegistrationLabel"
                                value="Registro profissional"
                            >

                        </div>


                        <div class="field full">

                            <label for="formacao">
                                Formação
                            </label>

                            <textarea
                                id="formacao"
                                rows="4"
                            ></textarea>

                        </div>


                        <div class="field full">

                            <label for="especializacoes">
                                Especializações
                            </label>

                            <textarea
                                id="especializacoes"
                                rows="4"
                            ></textarea>

                        </div>


                        <div class="field full">

                            <label for="experiencia">
                                Experiência
                            </label>

                            <textarea
                                id="experiencia"
                                rows="4"
                            ></textarea>

                        </div>

                    </div>

                </section>


                <!-- CONTATO -->

                <section class="card">

                    <div class="card-title">

                        <span>02</span>

                        <div>
                            <h2>Contato</h2>
                            <p>
                                Informações para contato e atendimento.
                            </p>
                        </div>

                    </div>


                    <div class="grid">

                        <div class="field">

                            <label for="whatsapp">
                                WhatsApp
                            </label>

                            <input
                                type="tel"
                                id="whatsapp"
                                placeholder="5511999999999"
                            >

                            <small>
                                Somente números, incluindo DDI e DDD.
                            </small>

                        </div>


                        <div class="field">

                            <label for="endereco">
                                Endereço
                            </label>

                            <input
                                type="text"
                                id="endereco"
                            >

                        </div>

                    </div>

                </section>


                <!-- FORMSPREE -->

                <section class="card">

                    <div class="card-title">

                        <span>03</span>

                        <div>
                            <h2>Formulário</h2>
                            <p>
                                Configuração do recebimento dos contatos.
                            </p>
                        </div>

                    </div>


                    <div class="field">

                        <label for="formspreeEndpoint">
                            Endpoint do Formspree
                        </label>

                        <input
                            type="url"
                            id="formspreeEndpoint"
                            placeholder="https://formspree.io/f/xxxxxxxx"
                        >

                        <small>
                            Cole aqui o endpoint completo do formulário.
                        </small>

                    </div>

                </section>


                <!-- REDES SOCIAIS -->

                <section class="card">

                    <div class="card-title">

                        <span>04</span>

                        <div>
                            <h2>Redes sociais</h2>
                            <p>
                                Links das redes profissionais.
                            </p>
                        </div>

                    </div>


                    <div class="grid">

                        <div class="field">

                            <label for="instagram">
                                Instagram
                            </label>

                            <input
                                type="url"
                                id="instagram"
                                placeholder="https://instagram.com/..."
                            >

                        </div>


                        <div class="field">

                            <label for="facebook">
                                Facebook
                            </label>

                            <input
                                type="url"
                                id="facebook"
                                placeholder="https://facebook.com/..."
                            >

                        </div>


                        <div class="field">

                            <label for="tiktok">
                                TikTok
                            </label>

                            <input
                                type="url"
                                id="tiktok"
                                placeholder="https://tiktok.com/@..."
                            >

                        </div>


                        <div class="field">

                            <label for="linkedin">
                                LinkedIn
                            </label>

                            <input
                                type="url"
                                id="linkedin"
                                placeholder="https://linkedin.com/in/..."
                            >

                        </div>

                    </div>

                </section>


                <!-- RASTREAMENTO -->

                <section class="card">

                    <div class="card-title">

                        <span>05</span>

                        <div>
                            <h2>Rastreamento</h2>
                            <p>
                                Integrações de marketing e análise.
                            </p>
                        </div>

                    </div>


                    <div class="tracking">

                        <div class="tracking-item">

                            <div class="field">

                                <label for="metaPixelId">
                                    Meta Pixel ID
                                </label>

                                <input
                                    type="text"
                                    id="metaPixelId"
                                >

                            </div>

                            <label class="switch">

                                <input
                                    type="checkbox"
                                    id="pixelEnabled"
                                >

                                <span></span>

                                Ativar Pixel

                            </label>

                        </div>


                        <div class="tracking-item">

                            <div class="field">

                                <label for="gaMeasurementId">
                                    Google Analytics
                                </label>

                                <input
                                    type="text"
                                    id="gaMeasurementId"
                                    placeholder="G-XXXXXXXXXX"
                                >

                            </div>

                            <label class="switch">

                                <input
                                    type="checkbox"
                                    id="gaEnabled"
                                >

                                <span></span>

                                Ativar GA

                            </label>

                        </div>


                        <div class="tracking-item">

                            <div class="field">

                                <label for="gtmId">
                                    Google Tag Manager
                                </label>

                                <input
                                    type="text"
                                    id="gtmId"
                                    placeholder="GTM-XXXXXXX"
                                >

                            </div>

                            <label class="switch">

                                <input
                                    type="checkbox"
                                    id="gtmEnabled"
                                >

                                <span></span>

                                Ativar GTM

                            </label>

                        </div>

                    </div>

                </section>


                <div class="save-area">

                    <span id="save-status"></span>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="save-button"
                    >
                        Salvar configurações
                    </button>

                </div>

            </form>

        </section>

    </div>

</main>


<footer class="footer">

    <span>
        ADM Katlen Ariane
    </span>

    <span>
        V8 Digital
    </span>

</footer>


<script src="admin.js"></script>

</body>

</html>
